# Terraform S3 backend configuration.
# Replace the placeholder values before running terraform init.
# use_lockfile enables native S3 state locking, so DynamoDB is not required.

bucket       = "CHANGE_ME_TF_STATE_BUCKET"
key          = "zwanga/eu-central-1/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
