# Copy this file to terraform/terraform.tfvars and replace the placeholder values.
# This file is for Terraform infra inputs only.
# Keep app env vars like DATABASE_URL and REDIS_URL outside Terraform.

# AWS
aws_region                  = "eu-central-1"
availability_zone           = "eu-central-1a"
secondary_availability_zone = "eu-central-1b"

# Network
vpc_cidr                     = "10.0.0.0/16"
public_subnet_cidr           = "10.0.1.0/24"
secondary_public_subnet_cidr = "10.0.2.0/24"

# Compute
ami_id                     = ""
instance_type              = "t3.micro"
secondary_instance_enabled = true
key_name                   = "CHANGE_ME_EC2_KEYPAIR_IN_EU_CENTRAL_1"
admin_cidr                 = "203.0.113.10/32"
instance_name              = "zwanga-api"

# Public access
# Set domain_name + caddy_email when you want Caddy to request public certificates.
domain_name = "api.example.com"
caddy_email = "ops@example.com"

# Nest.js Docker image
app_image_repository = "your-org/zwanga"
app_image_tag        = "latest"
# Set this only if your API exposes a public health route that you want to surface in outputs/docs.
app_healthcheck_path = "/health"

# Logs and alerts
log_retention_days    = 14
alarm_email_endpoints = []

# Optional AWS SSM parameters
ssm_secure_parameters = {}
